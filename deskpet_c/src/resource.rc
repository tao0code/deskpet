#include <windows.h>

/* 应用图标：使用系统默认 IDI_APPLICATION（避免依赖外部 .ico 文件） */
IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "DeskPet Project"
            VALUE "FileDescription",  "DeskPet - C 语言桌面宠物"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "DeskPet"
            VALUE "OriginalFilename", "DeskPet.exe"
            VALUE "ProductName",      "DeskPet"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
